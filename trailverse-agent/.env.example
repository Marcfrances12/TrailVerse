PORT=3001
CORS_ORIGIN=http://localhost:4200
# Solo lectura: usa un usuario de MongoDB con rol "read" sobre rutas_senderismo si es posible
MONGODB_URI=mongodb://127.0.0.1:27017/rutas_senderismo

# Proveedor LLM (OpenAI-compatible). Cambia solo estas variables para pasar de Groq a OpenRouter.
# Groq
LLM_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_REPLACE_ME
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=

# OpenRouter (alternativa)
# LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-REPLACE_ME
# LLM_MODEL=<modelo :free con tool calling>
# LLM_FALLBACK_MODEL=<otro modelo :free con tool calling>

AGENT_RATE_LIMIT_MAX=20
AGENT_RATE_LIMIT_WINDOW_MS=600000
AGENT_TIMEOUT_MS=30000
# Número de proxies delante del servicio (0 o vacío si no hay ninguno)
TRUST_PROXY=

OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=TrailVerse-Agent/1.0 (contacto@tudominio.com)
