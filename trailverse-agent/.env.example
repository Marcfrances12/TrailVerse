PORT=3001
CORS_ORIGIN=http://localhost:4200
# Solo lectura: usa un usuario de MongoDB con rol "read" sobre rutas_senderismo si es posible
MONGODB_URI=mongodb://127.0.0.1:27017/rutas_senderismo
# Solo para npm run faqs:generar: usuario con permiso de escritura sobre la colección rutas.
# Si se omite, el script usa MONGODB_URI.
MONGODB_URI_ESCRITURA=

# Proveedor principal del chat (OpenAI-compatible). Groq por defecto.
LLM_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_REPLACE_ME
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=

# Respaldo del chat (OpenRouter). Solo se usa si el principal falla antes de responder.
# Usa siempre modelos cuyo ID termine en :free y que soporten tools.
LLM_RESPALDO_BASE_URL=https://openrouter.ai/api/v1
LLM_RESPALDO_API_KEY=sk-or-v1-REPLACE_ME
LLM_RESPALDO_MODEL=google/gemma-4-31b-it:free

# Generación de FAQs (npm run faqs:generar). Gemini tiene nivel gratuito sin tarjeta.
FAQ_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAQ_LLM_API_KEY=REPLACE_ME
FAQ_LLM_MODEL=gemini-3.1-flash-lite

AGENT_RATE_LIMIT_MAX=30
AGENT_RATE_LIMIT_WINDOW_MS=600000
GUIA_RATE_LIMIT_MAX=60
GUIA_RATE_LIMIT_WINDOW_MS=600000
AGENT_TIMEOUT_MS=30000
# Número de proxies delante del servicio (0 o vacío si no hay ninguno)
TRUST_PROXY=

OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=TrailVerse-Agent/1.0 (contacto@tudominio.com)
